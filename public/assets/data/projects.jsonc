  "portflow": {
    "title": "Portflow",
    "bgImg": "/assets/images/projects/portflow_homepage.png",
    "projURL": "/portflow",
    "mainTech": "Next.js + NestJS + Redis",
    "detail": {
      "position": "Full-stack Developer",
      "duration": "Jan 2025 – Jun 2025",
      "technical": ["Next.js", "TypeScript", "Zustand", "NestJS", "Redis", "AWS S3", "Prisma"],
      "linkTrial": "",
      "linkCode": "",
      "description": {
        "overview": "Multi-tenant portfolio platform enabling users to create and publish professional portfolios through structured workflows, with draft-to-publish architecture and scalable cloud delivery.",
        "responsibilities": [
          "Designed draft-to-publish workflow with asset versioning for unpublished and public portfolio states.",
          "Implemented autosave using Zustand, local storage persistence, and scheduled sync to AWS S3/R2.",
          "Built media delivery with Presigned URLs for direct browser-to-cloud uploads without backend file proxying.",
          "Implemented Redis-based metadata caching for portfolio routing, slug resolution, and access validation.",
          "Architected the platform to support future subscription management and payment processing."
        ]
      }
    },
    "imgData": [
